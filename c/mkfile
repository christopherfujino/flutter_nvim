PROJECT = cnvim
CC = bear --append -- clang
CSTANDARD = -std=gnu23
DEBUG_FLAGS = -g -O0
CMP_ROOT = $PWD/../third_party/cmp-20
CMP_OBJ = $CMP_ROOT/cmp.o
CFLAGS = $DEBUG_FLAGS -Wall -Werror -Wextra -Wpedantic -Wvla $CSTANDARD -I$CMP_ROOT/
LDFLAGS = 

$PROJECT.exe: main.o $CMP_OBJ
	$CC $LDFLAGS $prereq -o $target

%.o: %.c
	$CC $CFLAGS -c $stem.c -o $target

$CMP_OBJ: ../third_party/cmp-20/cmp.c
	$CC $CFLAGS -c $prereq -o $target

#<../../mkfiles/static-lib-with-entrypoints.mkfile
